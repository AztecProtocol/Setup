{
  "name": "setup-mpc-common",
  "version": "1.0.0",
  "main": "dest/index.js",
  "license": "MIT",
  "files": [
    "dest"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.prod.json",
    "test": "jest"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    // Use the modern pattern to look for tests in a dedicated 'test' directory or __tests__
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    // Set rootDir to the project root for better test discovery
    "rootDir": ".", 
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "dependencies": {
    // Replaced moment with a modern alternative (e.g., date-fns)
    "date-fns": "^3.6.0", 
    "progress-stream": "^2.0.0",
    "@types/progress-stream": "^2.0.0",
    // Consider replacing web3x with ethers for a modern standard
    "ethers": "^6.10.0", 
    // isomorphic-fetch is often unnecessary in modern Node/Browser environments; 
    // keeping it simple or replacing with 'node-fetch' for Node 16/18 compatibility
    "node-fetch": "^3.3.2" 
  },
  "devDependencies": {
    // Updated critical dev dependencies to modern versions
    "typescript": "^5.3.3",
    "@types/node": "^20.11.20", 
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12",
    
    // TSLint is deprecated. Use ESLint with TypeScript plugins.
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5"
  }
}
